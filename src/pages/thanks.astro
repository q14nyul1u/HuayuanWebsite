---
import {getCurrentLanguage, useTranslations, getPathName} from "~/i18n/index.js";

const pathname = getPathName(Astro.url.pathname);
const currentLang = getCurrentLanguage(pathname);
const t = useTranslations(currentLang);

// Falls Sie Übersetzungen für die Danke-Seite haben
const translatedThankYou = t("contact.thankYou") || "Vielen Dank!";
const translatedThankYouMessage = t("contact.thankYouMessage") || "Ihre Nachricht wurde erfolgreich gesendet. Wir werden uns bald bei Ihnen melden.";
---

<html lang={currentLang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{translatedThankYou}</title>
</head>
<body>
<div class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="max-w-md w-full bg-white p-8 rounded-lg shadow-lg text-center">
        <div class="mb-6">
            <svg class="mx-auto h-12 w-12 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
        </div>

        <h1 class="text-2xl font-bold text-gray-900 mb-4">{translatedThankYou}</h1>
        <p class="text-gray-600 mb-6">{translatedThankYouMessage}</p>

        <a href="/" class="button button-blue">
            Zurück zur Startseite
        </a>
    </div>
</div>
</body>
</html>