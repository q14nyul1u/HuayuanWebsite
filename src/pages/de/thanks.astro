---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Article from "~/components/Article.astro";
---

<Layout>
    <Section class:list={'bg-white pt-20 pb-20'}>
        <Article>
            <h2>Vielen Dank</h2>
            <p>
                Wir haben Ihre Nachricht erhalten und werden uns baldmöglichst mit Ihnen in Verbindung setzen.
            </p>
        </Article>
    </Section>
</Layout>
