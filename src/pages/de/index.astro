---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import { Picture, Image } from "astro:assets";
import Button from "~/components/Button.astro";
import Grid from "~/components/Grid.astro";
import Heading from "~/components/Heading.astro";
import WideImage from "~/components/WideImage.astro";
import GoogleMap from "../../components/GoogleMap.astro";

// Images
import ChineseClass from "~/assets/images/chinese_class_10_24.png";
import CultureEvents from "~/assets/images/cultural_events.jpg";
import Teacher from "~/assets/images/teacher_10_15.jpg";
import SmallClass from "~/assets/images/small_class_10_14.jpg";
import Kaligraphie from "~/assets/images/kaligraphie_zh.jpg";
import DecorativeImage from "~/assets/images/great_wall_10_01.JPG";
import FixedButton from "../../components/FixedButton.astro";

const mapEmbedUrl1 = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7189.146666844624!2d11.531892692807965!3d48.14598215559082!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x479e761af5853d45%3A0x81f1b183b1748027!2sLandshuter%20Allee%2011%2C%2080637%20M%C3%BCnchen!5e0!3m2!1sen!2sde!4v1749129209002!5m2!1sen!2sde"
const mapEmbedUrl2 = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2459.820869447464!2d11.552060679869639!3d48.13757062869052!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x479e75ff70184481%3A0x4937509061487f3!2sEineWeltHaus!5e0!3m2!1sde!2sde!4v1749814356011!5m2!1sde!2sde"
---

<Layout title="HuaYuan" pageTitle="HuaYuan" description="Huayuan Chinesische Sprachschule">

	<WideImage image={DecorativeImage} alt="Just an image" class:list={"aspect-video lg:aspect-[21/6]"}/>
	<h1 class="font-black h4 mb-0 pt-10 ml-5 text-brand-blue text-center">Chinesische Sprachschule in München für Kinder
		und
		Erwachsene!</h1>

	<Section class:list={"bg-brand-blue/20 relative lg:pt-10 lg:pb-10"}>
		<Heading>
			<h2 slot="heading-title" class="font-black text-brand-blue h2">Ihre Vorteile</h2>
		</Heading>

		<Grid>
			<div slot="grid-content-1">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto"}
						src={CultureEvents}
						height={200}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h5 mt-0 font-black">Kulturelle Angebote</h3>
					<p>
						Wir ergänzen unsere Chinesischkurse durch regelmäßige kulturelle Veranstaltungen,
						die Einblicke in die chinesische Sprache und Kultur bieten – ideal zum vertieften Chinesisch
						lernen.
					</p>
				</div>
			</div>

			<div slot="grid-content-2">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto"}
						src={Teacher}
						height={200}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h5 mt-0 font-black">Erfahrene Lehrkräfte</h3>
					<p>
						Unsere erfahrenen Chinesisch-Lehrkräfte bieten hochwertigen Sprachunterricht für
						Kinder und Erwachsene – vom Anfänger bis zum Fortgeschrittenen.
					</p>
				</div>
			</div>

			<div slot="grid-content-3">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto"}
						src={SmallClass}
						height={200}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h5 mt-0 font-black">Kleine Klassengröße</h3>
					<p>
						In unseren Chinesischkursen lernen Sie in kleinen Gruppen mit maximal 10 Personen –
						für individuelle Betreuung und optimale Lernfortschritte beim Chinesischlernen.
					</p>
				</div>
			</div>
		</Grid>

		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-30 w-full top-0 inset-x-0 rotate-180"
			preserveAspectRatio="none"
		>
			<path
				fill="#ffffff"
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-30 w-full bottom-0 inset-x-0"
			preserveAspectRatio="none"
		>
			<path
				fill="#ffffff"
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
	</Section>

	<Section contain={false} class:list={"bg-white container py-16 lg:py-32 lg:pt-0 lg:pb-10"}>
		<Hero>
			<div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
				<h3 class="font-black text-brand-blue h3 !my-4">Unsere Kursangebote</h3>
				<span class=" text-2xl font-bold italic">
					Wir bieten eine kostenlose Beratung an</span>
				<!--<span class="text-brand-blue text-2xl font-bold italic">Wir bieten die folgenden Kurse an</span>-->
				<p>
					📖 Abendkurse HSK 1-6
				</p>
				<p>
					📖 Business Chinesisch
				</p>
				<p>
					📖 Privatunterricht 1:1 oder 1:2
				</p>
				<p>
					📖 Aussprachetraining
				</p>
				<p>
					📖 Wochenendkurse für Kinder
				</p>
				<p>
					📖 Andere spezielle Unterrichtsangebote
				</p>
				<div class="mt-8">
					<Button color="blue" url="/de/lessons">Mehr erfahren</Button>
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto"}
					src={Kaligraphie}
					height={600}
					formats={["avif", "webp"]}
					alt="A description of my image."
				/>
			</div>
		</Hero>
	</Section>

	<Section class:list={"bg-brand-blue/20 relative"}>
		<div class="py-16 lg:pt-2 lg:pb-5">
			<Hero>
				<div slot="hero-content-right" class="text-center prose max-w-none order-2">
					<h2 slot="heading-title" class="font-black text-brand-blue h2 !my-4">Adresse</h2>
					<div slot="heading-content">
						<p>
							<b>Adresse：</b> Schwanthalerstraße 80, 80336 München
						</p>

						<p>
							<b>ÖPNV：</b>U-Bahn bis <i>Theresienwiese</i>, dann 2 Minuten zu Fuß
						</p>

						<p>
							<b>Parkplätze：</b> In der Nähe der U-Bahnstation <i>Theresienwiese</i> gibt es
							kostenlose und kostenpflichtige Parkplätze
						</p>

					</div>
				</div>
				<div slot="hero-content-left">
					<GoogleMap
						embedUrl={mapEmbedUrl2}
						height="400"
						title="Unser Standort"
					/>
				</div>
			</Hero>
		</div>

		<!--<svg-->
