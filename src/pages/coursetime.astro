---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Heading from "~/components/Heading.astro";
import Button from "~/components/Button.astro";
import { Picture, Image } from "astro:assets";
import CourseDropdown from "../components/CourseDropdown.astro";
import ScheduledTableAutumnSaturday from "../components/ScheduledTableAutumnSaturday.astro";
import ScheduledTableAutumnQinzi from "../components/ScheduledTableAutumnQinzi.astro";
import ScheduledTableSpringQinzi from "../components/ScheduledTableSpringQinzi.astro";
import ScheduledTableSpringHuiBen from "../components/ScheduledTableSpringHuiBen.astro";
import ScheduledTableSpringSaturday from "../components/ScheduledTableSpringSaturday.astro";

// Dropdown-Konfigurationen
const autumnCourses = [
	{
		id: "qinzi-autumn",
		label: "亲子启蒙",
		component: ScheduledTableAutumnQinzi
	},
	{
		id: "shizi-autumn",
		label: "识字启蒙",
		component: ScheduledTableAutumnSaturday
	},
    {
        id: "yuwen-autumn",
        label: "各个中文班",
        component: ScheduledTableAutumnSaturday
    }
];

const springCourses = [
	{
		id: "qinzi-spring",
		label: "亲子启蒙",
		component: ScheduledTableSpringQinzi
	},
	{
		id: "huiben-spring",
		label: "绘本启蒙",
		component: ScheduledTableSpringHuiBen
	},
	{
		id: "shizi-spring",
		label: "识字启蒙",
		component: ScheduledTableSpringSaturday
	},
    {
        id: "yuwen-spring",
        label: "各个中文班",
        component: ScheduledTableSpringSaturday
    }
];
---

<Layout>
	<Section contain={false} class:list={"bg-white container py-16 pt-10 lg:pb-10"}>
		<div class="grid lg:grid-cols-2 gap-8">
			{/* Herbst: Rot + Blau */}
			<CourseDropdown
				titlePart1="秋季"
				titlePart2="学期课程表"
				titlePart1Color="#DAA520"
				titlePart2Color="#2980b9"
				courses={autumnCourses}
				uniqueId="autumn"
			/>

			{/* Frühling: Grün + Blau */}
			<CourseDropdown
				titlePart1="春季"
				titlePart2="学期课程表"
				titlePart1Color="#5eab7e"
				titlePart2Color="#2980b9"
				courses={springCourses}
				uniqueId="spring"
			/>
		</div>
	</Section>
</Layout>

<style>
	.tab-button,
	.tab-button-autumn {
		border-color: transparent;
		color: #6b7280;
	}

	.tab-button:hover,
	.tab-button-autumn:hover {
		color: #2980b9;
		border-color: #2980b9;
	}

	.tab-button.active,
	.tab-button-autumn.active {
		color: #2980b9;
		border-color: #2980b9;
	}

	.tab-content,
	.tab-content-autumn {
		display: block;
	}

	.tab-content.hidden,
	.tab-content-autumn.hidden {
		display: none;
	}
</style>

<script>
	function initializeTabs() {
		// Spring Tabs (rechte Seite)
		const buttonsSpring = document.querySelectorAll('.tab-button');
		const contentsSpring = document.querySelectorAll('.tab-content');

		if (buttonsSpring.length > 0) {
			// Ersten Tab als aktiv setzen
			buttonsSpring[0]?.classList.add('active');
			contentsSpring.forEach((content, index) => {
				if (index === 0) {
					content.classList.remove('hidden');
				} else {
					content.classList.add('hidden');
				}
			});

			buttonsSpring.forEach(button => {
				button.addEventListener('click', () => {
					const tabId = button.getAttribute('data-tab');

					// Alle Buttons deaktivieren
					buttonsSpring.forEach(btn => btn.classList.remove('active'));

					// Aktuellen Button aktivieren
					button.classList.add('active');

					// Alle Contents verstecken
					contentsSpring.forEach(content => content.classList.add('hidden'));

					// Aktuellen Content anzeigen
					const activeContent = document.querySelector(`[data-tab-content="${tabId}"]`);
					activeContent?.classList.remove('hidden');
				});
			});
		}

		// Autumn Tabs (linke Seite)
		const buttonsAutumn = document.querySelectorAll('.tab-button-autumn');
		const contentsAutumn = document.querySelectorAll('.tab-content-autumn');

		if (buttonsAutumn.length > 0) {
			// Ersten Tab als aktiv setzen
			buttonsAutumn[0]?.classList.add('active');
			contentsAutumn.forEach((content, index) => {
				if (index === 0) {
					content.classList.remove('hidden');
				} else {
					content.classList.add('hidden');
				}
			});

			buttonsAutumn.forEach(button => {
				button.addEventListener('click', () => {
					const tabId = button.getAttribute('data-tab');

					// Alle Buttons deaktivieren
					buttonsAutumn.forEach(btn => btn.classList.remove('active'));

					// Aktuellen Button aktivieren
					button.classList.add('active');

					// Alle Contents verstecken
					contentsAutumn.forEach(content => content.classList.add('hidden'));

					// Aktuellen Content anzeigen
					const activeContent = document.querySelector(`[data-tab-content="${tabId}"]`);
					activeContent?.classList.remove('hidden');
				});
			});
		}
	}

	// Initialisierung beim ersten Laden
	document.addEventListener('DOMContentLoaded', initializeTabs);

	// Initialisierung nach Astro View Transitions
	document.addEventListener('astro:page-load', initializeTabs);
</script>