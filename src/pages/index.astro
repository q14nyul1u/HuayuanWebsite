---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import { Picture, Image } from "astro:assets";
import Button from "~/components/Button.astro";
import Grid from "~/components/Grid.astro";
import Heading from "~/components/Heading.astro";
import WideImage from "~/components/WideImage.astro";
import FixedButton from "../components/FixedButton.astro";
import CourseScheduleSection from "../components/CourseScheduleSection.astro";
import CourseScheduleSectionQiMeng from "../components/CourseScheduleSectionQiMeng.astro";
import GoogleMap from "~/components/GoogleMap.astro";
// Images
import ChineseClass from "~/assets/images/chinese_class_10_24.png";
import YuwenBooks from "~/assets/images/yuwen_books_12_21.png";
import Teacher from "~/assets/images/teacher_10_15.jpg";
import SmallClass from "~/assets/images/small_class_10_14.jpg";
import UnterrichtsDesign from "~/assets/images/unterrichtsdesign_19_03_10_40.png";
import DecorativeImage from "~/assets/images/great_wall_10_01.JPG";
import flyer1 from "~/assets/images/AlleKurseQimeng_05_04_14_42.png";
import flyer2 from "~/assets/images/AlleKurseYuwen_26_03_20_45.png";

const mapEmbedUrl1 = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4682.335173245069!2d11.563741311849157!3d48.13494082874444!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x479ddf58a6efecbf%3A0x231e8dda7838077!2sEvang.%20Familien-Bildungsst%C3%A4tte%20%22Elly%20Heuss-Knapp%22%20gemeinn%C3%BCtzige%20GmbH!5e0!3m2!1sde!2sde!4v1763903956502!5m2!1sde!2sde"
const mapEmbedUrl2 = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2459.820869447464!2d11.552060679869639!3d48.13757062869052!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x479e75ff70184481%3A0x4937509061487f3!2sEineWeltHaus!5e0!3m2!1sde!2sde!4v1749814356011!5m2!1sde!2sde"

---

<Layout title="HuaYuan" pageTitle="HuaYuan" description="Huayuan Chinesischschule">

	<WideImage image={DecorativeImage} alt="Just an image" class:list={"aspect-video lg:aspect-[21/6]"}/>

    <Section contain={false} class:list={"bg-white container py-16 pt-10 lg:pb-10"}>
		<div class="text-center mb-10 mt-0">
            <h2 class="font-black text-brand-blue h2">2026/2027新学年<span class="text-[#5eab7e]">火热招生</span>！</h2>
        </div>

        <div class="text-center mb-10 mt-0">
            <h4 class="font-black text-brand-blue h4">欢 迎 加 入 慕&nbsp;尼&nbsp;黑 华&nbsp;源&nbsp;中&nbsp;文&nbsp;学&nbsp;校</h>
        </div>

        <!-- Flyer Bereich -->
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
            <!-- Flyer 1 -->
            <div class="flex flex-col justify-start items-center gap-6">
                <a
                    href="/coursetimeQiMeng"
                    class="no-underline hover:opacity-80 transition-opacity px-4 py-2.5 lg:px-6 lg:py-3 rounded-full inline-block relative z-20 text-center w-fit max-w-full"
                    style="background-color: #2980b9;"
                >
                    <span class="font-black text-white text-base sm:text-lg lg:text-xl m-0 whitespace-nowrap block">查看启蒙课程上课时间</span>
                </a>
                <Picture
                    class:list={"w-full h-auto lg:h-270 max-w-md"}
                    src={flyer1}
                    formats={["avif", "webp"]}
                    alt="Alle Kurse Flyer"
                />
            </div>

            <!-- Flyer 2 -->
            <div class="flex flex-col justify-start items-center gap-6">
                <a
                    href="/coursetimeZH"
                    class="no-underline hover:opacity-80 transition-opacity px-4 py-2.5 lg:px-6 lg:py-3 rounded-full inline-block relative z-20 text-center w-fit max-w-full"
                    style="background-color: #2980b9;"
                >
                    <span class="font-black text-white text-base sm:text-lg lg:text-xl m-0 whitespace-nowrap block">查看中文课程上课时间</span>
                </a>
                <Picture
                    class:list={"w-full h-auto lg:h-270 max-w-md"}
                    src={flyer2}
                    formats={["avif", "webp"]}
                    alt="All Yuwen Flyer"
                />
            </div>
        </div>

	</Section>

	<Section class:list={"bg-brand-blue/20 relative lg:pt-15 lg:pb-15"}>
		<Heading>
			<h2 slot="heading-title" class="font-black text-brand-blue h2">课程特色</h2>
		</Heading>

		<Grid>
			<div slot="grid-content-1">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto"}
						src={YuwenBooks}
						height={230}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h5 mt-0 font-black">采用国内统编教材《语文》</h3>
					<p>
						采用国内统编教材《语文》(由中国教育部统一编写,全国通用语文教材)。
					</p>
				</div>
			</div>

			<div slot="grid-content-2">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto"}
						src={Teacher}
						height={250}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h5 mt-0 font-black">有十年以上教学经验的老师</h3>
					<p>
						拥有海外十年以上中文教学经验的老师亲自授课。实现教学内容与国内同步,系统正规学习中文。
					</p>
				</div>
			</div>

			<div slot="grid-content-3">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto"}
						src={SmallClass}
						height={250}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h5 mt-0 font-black">小班授课个性化辅导</h3>
					<p>
						小班授课(每班不超过10人),让孩子课上得到更多的训练,
						激发每个孩子学习中文的兴趣。
					</p>
				</div>
			</div>
		</Grid>

		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-30 w-full top-0 inset-x-0 rotate-180"
			preserveAspectRatio="none"
		>
			<path
				fill="#ffffff"
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-30 w-full bottom-0 inset-x-0"
			preserveAspectRatio="none"
		>
			<path
				fill="#ffffff"
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
	</Section>

	<Section contain={false} class:list={"bg-white container"}>
		<div class="text-center">
			<h2 slot="heading-title" class="font-black text-brand-blue h2">儿童中文课程设计</h2>
				<Picture
					class:list={"mx-auto"}
					src={UnterrichtsDesign}
					height={450}
					formats={["avif", "webp"]}
					alt="A description of my image."
				/>
		</div>
	</Section>

	<Section class:list={"bg-brand-blue/20 relative"}>
		<div class="py-16 lg:pt-2 lg:pb-6">
			<Hero>
				<div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
					<h2 slot="heading-title" class="font-black text-brand-blue h2">我们提供以下课程</h2>

					<p>
						📖 中文亲子
					</p>
					<p>
						📖 中文启蒙
					</p>
					<p>
						📖 各年级语文课程
					</p>
					<p>
						📖 其它特色课程
					</p>
					<div class="mt-8 relative z-20">
						<Button color="blue" url="/lessons">了解课程详细内容</Button>
					</div>
				</div>
				<div slot="hero-content-right">
					<Picture
						class:list={"mx-auto"}
						src={ChineseClass}
						height={600}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
				</div>
			</Hero>
		</div>

		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-25 w-full top-0 inset-x-0 rotate-180"
			preserveAspectRatio="none"
		>
			<path
				fill="#ffffff"
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-30 w-full bottom-0 inset-x-0"
			preserveAspectRatio="none"
		>
			<path
				fill="#ffffff"
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
	</Section>

    <Section contain={false} class:list={"bg-white container py-16 pt-10 lg:pb-10"}>
		<div class="text-center lg:pb-6">
			<h2 slot="heading-title" class="font-black text-brand-blue h2">启蒙课程上课时间和地址</h2>
		</div>
		<Hero>
		<div slot="hero-content-right" class="text-center prose max-w-none order-2">
			<h2 slot="heading-title" class="font-black text-brand-blue h2 !my-4">Altstadt-Lehel</h2>
			<div slot="heading-content">
				<p>
					<b>教学地址:</b> Herzog-Wilhelm-Straße 24, 80331 München (慕尼黑)
				</p>

				<p>
					<b>公共交通:</b>乘坐地铁到 <i>Sendlinger Tor</i> 站, 下车步行2分钟
				</p>

				<p>
					<b>停车位:</b> 地铁站 <i>Sendlinger Tor</i> 附近有免费或收费停车位
				</p>
			</div>
		</div>
		<div slot="hero-content-right">
			<GoogleMap
				embedUrl={mapEmbedUrl1}
				height="400"
				title="Unser Standort"
			/>
		</div>
	</Hero>
	<CourseScheduleSectionQiMeng />
	</Section>

	<Section class:list={"bg-brand-blue/20 relative"}>
		<div class="text-center lg:pt-10 lg:pb-6">
			<h2 slot="heading-title" class="font-black text-brand-blue h2">中文课程上课时间和地址</h2>
		</div>
		<Hero>
			<div slot="hero-content-right" class="text-center prose max-w-none order-2">
				<h2 slot="heading-title" class="font-black text-brand-blue h2 !my-4">Ludwigsvorstadt-Isarvorstadt</h2>
				<div slot="heading-content">
					<p>
						<b>教学地址:</b> Schwanthalerstraße 80, 80336 München (慕尼黑)
					</p>

					<p>
						<b>公共交通:</b>乘坐地铁到 <i>Theresienwiese</i> 站, 下车步行2分钟
					</p>

					<p>
						<b>停车位:</b> 地铁站 <i>Theresienwiese</i> 附近有免费或收费停车位
					</p>
				</div>
			</div>
			<div slot="hero-content-right">
				<GoogleMap
					embedUrl={mapEmbedUrl2}
					height="400"
					title="Unser Standort"
				/>
			</div>
		</Hero>
		<CourseScheduleSection />
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 1440 320"
            class="absolute h-30 w-full top-0 inset-x-0 rotate-180"
            preserveAspectRatio="none"
        >
            <path
                fill="#ffffff"
                fill-opacity="1"
                d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
            ></path>
        </svg>
	</Section>
	<FixedButton
		href="/contact"
		text="课程咨询"
		position='bottom'
	/>
</Layout>
