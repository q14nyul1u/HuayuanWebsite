<style>
	.tab-button,
	.tab-button-autumn {
		border-color: transparent;
		color: #6b7280;
	}

	.tab-button:hover,
	.tab-button-autumn:hover {
		color: #2980b9;
		border-color: #2980b9;
	}

	.tab-button.active,
	.tab-button-autumn.active {
		color: #2980b9;
		border-color: #2980b9;
	}

	.tab-content,
	.tab-content-autumn {
		display: block;
	}

	.tab-content.hidden,
	.tab-content-autumn.hidden {
		display: none;
	}
</style>

<script>
	function initializeTabs() {
		// Spring Tabs (rechte Seite)
		const buttonsSpring = document.querySelectorAll('.tab-button');
		const contentsSpring = document.querySelectorAll('.tab-content');

		if (buttonsSpring.length > 0) {
			// Ersten Tab als aktiv setzen
			buttonsSpring[0]?.classList.add('active');
			contentsSpring.forEach((content, index) => {
				if (index === 0) {
					content.classList.remove('hidden');
				} else {
					content.classList.add('hidden');
				}
			});

			buttonsSpring.forEach(button => {
				button.addEventListener('click', () => {
					const tabId = button.getAttribute('data-tab');

					// Alle Buttons deaktivieren
					buttonsSpring.forEach(btn => btn.classList.remove('active'));

					// Aktuellen Button aktivieren
					button.classList.add('active');

					// Alle Contents verstecken
					contentsSpring.forEach(content => content.classList.add('hidden'));

					// Aktuellen Content anzeigen
					const activeContent = document.querySelector(`[data-tab-content="${tabId}"]`);
					activeContent?.classList.remove('hidden');
				});
			});
		}

		// Autumn Tabs (linke Seite)
		const buttonsAutumn = document.querySelectorAll('.tab-button-autumn');
		const contentsAutumn = document.querySelectorAll('.tab-content-autumn');

		if (buttonsAutumn.length > 0) {
			// Ersten Tab als aktiv setzen
			buttonsAutumn[0]?.classList.add('active');
			contentsAutumn.forEach((content, index) => {
				if (index === 0) {
					content.classList.remove('hidden');
				} else {
					content.classList.add('hidden');
				}
			});

			buttonsAutumn.forEach(button => {
				button.addEventListener('click', () => {
					const tabId = button.getAttribute('data-tab');

					// Alle Buttons deaktivieren
					buttonsAutumn.forEach(btn => btn.classList.remove('active'));

					// Aktuellen Button aktivieren
					button.classList.add('active');

					// Alle Contents verstecken
					contentsAutumn.forEach(content => content.classList.add('hidden'));

					// Aktuellen Content anzeigen
					const activeContent = document.querySelector(`[data-tab-content="${tabId}"]`);
					activeContent?.classList.remove('hidden');
				});
			});
		}
	}

	// Initialisierung beim ersten Laden
	document.addEventListener('DOMContentLoaded', initializeTabs);

	// Initialisierung nach Astro View Transitions
	document.addEventListener('astro:page-load', initializeTabs);
</script>