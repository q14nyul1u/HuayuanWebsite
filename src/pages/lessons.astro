---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import LessonsZHList from "~/components/LessonsZH.astro";
import FixedButton from "../components/FixedButton.astro";
import ScheduledTableAutumn from "../components/ScheduledTableAutumn.astro";
import ScheduledTableSpring from "../components/ScheduledTableSpring.astro";
---
<Layout>
	<Section>
		<!--<Heading>-->
		<!--	<h1 slot="heading-title" class="font-black text-brand-blue h2">课程介绍</h1>-->
		<!--</Heading>-->
		<FixedButton
			href="/contact"
			text="课程咨询"
			position='middle'

		/>
		<LessonsZHList/>
		<!-- Grid für nebeneinander liegende Tabellen -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-15">
			<!-- Scheduled Table - 1/2 der Breite -->
			<div class="flex flex-col">
				<ScheduledTableAutumn></ScheduledTableAutumn>
			</div>

			<!-- Scheduled Table - 1/2 der Breite -->
			<div class="flex flex-col">
				<ScheduledTableSpring></ScheduledTableSpring>
			</div>
		</div>
	</Section>
</Layout>
