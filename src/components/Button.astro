---
const {
	color = "green",
	url = "",
	newtab = false,
	As = "a",
	spacing = "",
	...props
} = Astro.props;
---

<As
	class={`not-prose button button-${color} ${spacing} whitespace-nowrap text-xs sm:text-sm md:text-base`}
	href={url}
	target={newtab ? "_blank" : "_self"}
	rel={newtab ? "noopener noreferrer" : ""}
	{...props}
>
	<slot />
</As>