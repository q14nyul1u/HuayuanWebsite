---
// ScheduledTableSpringQinzi.astro
interface Props {
    paddingTop?: string;
}

const {paddingTop = "pt-0"} = Astro.props;
---

<div class={`max-w-4xl mx-auto px-4 ${paddingTop}`}>
    <table class="w-full border-collapse">
        <thead>
        <tr class="bg-brand-blue text-white">
            <th class="border border-gray-300 px-6 py-4 text-left font-semibold text-lg">
                月份
            </th>
            <th class="border border-gray-300 px-6 py-4 text-center font-semibold text-lg">
                日期
            </th>
        </tr>
        </thead>
        <tbody>
        <!-- 2月 -->
        <tr>
            <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                4月
            </td>
            <td class="border border-gray-300 px-6 py-4 text-center">
                18, 25
            </td>
        </tr>

        <!-- 3月 -->
        <tr class="bg-gray-50">
            <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                5月
            </td>
            <td class="border border-gray-300 px-6 py-4 text-center">
                09, 16, 23
            </td>
        </tr>

        <!-- 4月 -->
        <tr>
            <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                6月
            </td>
            <td class="border border-gray-300 px-6 py-4 text-center">
                13, 20, 27
            </td>
        </tr>

        <!-- 5月 -->
        <tr class="bg-gray-50">
            <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                7月
            </td>
            <td class="border border-gray-300 px-6 py-4 text-center">
               04, 11
            </td>
        </tr>
        </tbody>
    </table>
</div>