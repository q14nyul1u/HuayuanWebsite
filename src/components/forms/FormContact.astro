---
import {getCurrentLanguage, useTranslations, getPathName} from "~/i18n/index.js";

const pathname = getPathName(Astro.url.pathname);
const currentLang = getCurrentLanguage(pathname);
const t = useTranslations(currentLang);

// Variablen, die die übersetzten Texte enthalten
const translatedName = t("contact.name");
const translatedEmail = t("contact.email");
const translatedMessage = t("contact.message");
const translatedBasicInfo = t("contact.basicInfo");
const translatedHelperTextBasicInfo = t("contact.helperTextBasicInfo");
const translatedHelperTextMessage = t("contact.helperTextMessage");
const translatedSend = t("contact.send");

let message = "";
let messageType = "";

// Server-side Form Handling
if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const name = data.get("name") as string;
        const email = data.get("email") as string;
        const basicInfo = data.get("basicInfo") as string;
        const messageText = data.get("message") as string;

        // E-Mail senden mit nodemailer

        const nodemailer = await import('nodemailer');

        // SMTP Konfiguration - verwenden Sie Ihre SMTP-Daten
        const transporter = nodemailer.createTransporter({
            host: process.env.SMTP_HOST || 'smtp.strato.de', // Beispiel für Strato
            port: parseInt(process.env.SMTP_PORT || '587'),
            secure: false, // true für Port 465, false für andere Ports
            auth: {
                user: process.env.SMTP_USER, // Ihre Absender-E-Mail
                pass: process.env.SMTP_PASS  // Ihr E-Mail-Passwort
            }
        });

        // E-Mail Inhalt
        const mailOptions = {
            from: process.env.SMTP_USER, // Absender (Ihre E-Mail)
            to: 'info@blabla.de', // Ziel-E-Mail-Adresse
            replyTo: email, // Reply-To auf die E-Mail des Kontaktformulars setzen
            subject: `Neue Kontaktanfrage von ${name}`,
            html: `
        <h2>Neue Kontaktanfrage über das Kontaktformular</h2>
        <p><strong>Name:</strong> ${name}</p>
        <p><strong>E-Mail:</strong> ${email}</p>
        <p><strong>Grundlegende Informationen:</strong></p>
        <p>${basicInfo.replace(/\n/g, '<br>')}</p>
        <p><strong>Nachricht:</strong></p>
        <p>${messageText.replace(/\n/g, '<br>')}</p>
        <hr>
        <p><small>Diese E-Mail wurde über das Kontaktformular Ihrer Website gesendet.</small></p>
      `
        };

        await transporter.sendMail(mailOptions);
        message = "Ihre Nachricht wurde erfolgreich gesendet!";
        messageType = "success";

    } catch (error) {
        console.error('Fehler beim Senden der E-Mail:', error);
        message = "Fehler beim Senden der Nachricht. Bitte versuchen Sie es später erneut.";
        messageType = "error";
    }
}
---

<form method="POST">
    {message && (
            <div class={`p-4 mb-4 rounded ${messageType === 'success' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
                {message}
            </div>
    )}

    <div class="flex flex-col gap-8 mx-auto max-w-md">
        <div>
            <label for="name">{translatedName}</label>
            <div class="mt-2">
                <input type="text" name="name" id="name" required />
            </div>
        </div>

        <div>
            <label for="email">{translatedEmail}</label>
            <div class="mt-2 grid grid-cols-1">
                <input type="email" name="email" id="email" required/>
            </div>
        </div>
        <div>
            <label for="message">{translatedBasicInfo}</label>
            <div class="mt-2">
                <textarea name="basicInfo" placeholder={translatedHelperTextBasicInfo} id="basicInfo" rows="4"
                          required></textarea>
            </div>
        </div>

        <div>
            <label for="message">{translatedMessage}</label>
            <div class="mt-2">
                <textarea name="message" placeholder={translatedHelperTextMessage} id="message" rows="5"
                          required></textarea>
            </div>
        </div>

        <div>
            <button type="submit" class="button button-blue group !px-8">
                <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-5 -rotate-45 -mt-1 inline-block mr-1 group-hover:rotate-0 transition duration-300"
                >
                    <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
                    ></path>
                </svg>
                {translatedSend}
            </button>
        </div>
    </div>
</form>