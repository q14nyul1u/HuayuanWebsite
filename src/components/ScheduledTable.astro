---
// ScheduledTable.astro
---

<div class="max-w-4xl mx-auto px-4 pt-10">
    <div class="mb-6 text-center">
        <h3 class="h5 mt-0 font-black">继&nbsp承&nbsp语&nbsp教&nbsp学 -
            冬&nbsp季&nbsp学&nbsp期&nbsp课&nbsp程&nbsp表</h3>
    </div>

    <table class="w-full border-collapse">
        <thead>
        <tr class="bg-brand-blue text-white">
            <th class="border border-gray-300 px-6 py-4 text-left font-semibold text-lg">
                月份
            </th>
            <th class="border border-gray-300 px-6 py-4 text-center font-semibold text-lg">
                日期
            </th>
        </tr>
        </thead>
        <tbody>
        <!-- 9月 -->
        <tr>
            <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                9月
            </td>
            <td class="border border-gray-300 px-6 py-4 text-center">
                20，27
            </td>
        </tr>

        <!-- 10月 -->
        <tr class="bg-gray-50">
            <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                10月
            </td>
            <td class="border border-gray-300 px-6 py-4 text-center">
                11，18，25
            </td>
        </tr>

        <!-- 11月 -->
        <tr>
            <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                11月
            </td>
            <td class="border border-gray-300 px-6 py-4 text-center">
                15，22，29
            </td>
        </tr>

        <!-- 12月 -->
        <tr class="bg-gray-50">
            <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                12月
            </td>
            <td class="border border-gray-300 px-6 py-4 text-center">
                6，13，20
            </td>
        </tr>

        <!-- 1月 -->
        <tr>
            <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                1月
            </td>
            <td class="border border-gray-300 px-6 py-4 text-center">
                10，17，24，31
            </td>
        </tr>

        <!-- 2月 -->
        <tr class="bg-gray-50">
            <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                2月
            </td>
            <td class="border border-gray-300 px-6 py-4 text-center">
                7，14
            </td>
        </tr>
        </tbody>
    </table>
</div>