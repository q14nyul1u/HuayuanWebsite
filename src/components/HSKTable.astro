---
// ScheduledTable.astro
---

<div class="max-w-4xl mx-auto px-4 pt-15">
    <div class="mb-6 text-center">
        <h3 class="h5 mt-0 font-black">
            HSK Kursaufteilung</h3>
    </div>

    <!-- Responsive Tabelle -->
    <div class="overflow-x-auto">
        <table class="w-full border-collapse min-w-full">
            <thead>
            <tr class="bg-brand-blue text-white">
                <th class="border border-gray-300 px-2 md:px-3 py-2 md:py-3 text-left font-semibold text-sm md:text-base min-w-[80px]">
                    Kurse
                </th>
                <th class="border border-gray-300 px-2 md:px-3 py-2 md:py-3 text-center font-semibold text-sm md:text-base min-w-[120px]">
                    Kursdauer
                </th>
                <th class="border border-gray-300 px-2 md:px-3 py-2 md:py-3 text-center font-semibold text-sm md:text-base min-w-[200px]">
                    Was kann ich nach dem Kurs?
                </th>
            </tr>
            </thead>
            <tbody>
            <!-- HSK 1 Teil 1 -->
            <tr>
                <td class="border text-nowrap border-gray-300 px-6 py-4 font-medium text-lg">
                    HSK 1.1
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    20 Unterrichtseinheiten à 45 Minuten
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center align-middle" rowspan="2">
                    Anfänger, die einfache Wörter und Sätze verstehen und verwenden können.
                </td>
            </tr>
            <!-- HSK 1 Teil 2 -->
            <tr>
                <td class="border text-nowrap border-gray-300 px-6 py-4 font-medium text-lg">
                    HSK 1.2
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    20 Unterrichtseinheiten à 45 Minuten
                </td>
                <!-- Keine dritte Spalte hier, da sie mit der vorherigen Zeile verbunden ist -->
            </tr>
            <!-- HSK 2 Teil 1 -->
            <tr>
                <td class="border text-nowrap border-gray-300 px-6 py-4 font-medium text-lg">
                    HSK 2.1
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    20 Unterrichtseinheiten à 45 Minuten
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center align-middle" rowspan="2">
                    Fortgeschrittene Anfänger, die grundlegende chinesische Ausdrücke im Alltag verwenden können.
                </td>
            </tr>
            <!-- HSK 2 Teil 2 -->
            <tr>
                <td class="border text-nowrap border-gray-300 px-6 py-4 font-medium text-lg">
                    HSK 2.2
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    20 Unterrichtseinheiten à 45 Minuten
                </td>
                <!-- Keine dritte Spalte hier, da sie mit der vorherigen Zeile verbunden ist -->
            </tr>
            <!-- HSK 3-->
            <tr>
                <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                    HSK 3
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    30 Unterrichtseinheiten à 45 Minuten
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    Lernende, die grundlegende Kommunikation in Alltag, Studium und Beruf bewältigen können.
                </td>
            </tr>
            <!-- HSK 4-->
            <tr>
                <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                    HSK 4
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    30 Unterrichtseinheiten à 45 Minuten
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">

                    Lernende, die in der Lage sind, sich zu verschiedenen Themen zu äußern und mit Muttersprachlern
                    relativ flüssig zu kommunizieren.
                </td>
            </tr>
            <!-- HSK 5-->
            <tr>
                <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                    HSK 5
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    30 Unterrichtseinheiten à 45 Minuten
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    Lernende, die chinesische Zeitungen und Zeitschriften lesen, chinesische Filme und Fernsehsendungen
                    verstehen und eine chinesische Rede halten können.
                </td>
            </tr>
            <!-- HSK 6-->
            <tr>
                <td class="border border-gray-300 px-6 py-4 font-medium text-lg">
                    HSK 6
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    30 Unterrichtseinheiten à 45 Minuten
                </td>
                <td class="border border-gray-300 px-6 py-4 text-center">
                    Lernende, die das Gelesene und Gehörte problemlos verstehen und sich fließend, spontan
                    und präzise ausdrücken können.
                </td>
            </tr>
            </tbody>
        </table>
    </div>