---
import {Picture} from "astro:assets";
export interface Props {
    href: string;
    text?: string;
    position?: 'top' | 'middle' | 'bottom';
}

const {
    href,
    text = "课程咨询",
    position = "middle",
} = Astro.props;

const positionClass = {
    top: 'top-20',
    middle: 'top-1/2 -translate-y-1/2',
    bottom: 'bottom-20'
}[position];

import CustomerService from "~/assets/images/customer-service-transparent.png";
---
<a
        href={href}
        class={`contact-button fixed right-0 z-40 transition-all duration-300 hover:scale-105 ${positionClass}`}
        id="fixed-button"
        title={text}
        data-position={position}
>
    <!-- Telefon Icon (Customer Service) -->
    <div class="bg-brand-blue hover:bg-blue-600 text-white p-5 rounded-l-lg shadow-lg flex items-center justify-center transition-colors duration-200">
        <Picture
                class:list={"not-prose w-full h-auto"}
                src={CustomerService}
                height={50}
                formats={["avif", "webp"]}
                alt="A description of my image."
        />
    </div>
</a>

<script>
    class FixedButtonController {
        constructor() {
            this.button = document.getElementById('fixed-button');
            this.footer = document.querySelector('footer');
            this.isHidden = false;

            if (this.button && this.footer) {
                this.init();
            }
        }

        init() {
            // Prüfe die Position des Buttons
            const buttonPosition = this.button.getAttribute('data-position') || 'middle';

            // Footer-Überlappung nur bei 'bottom' Position prüfen
            if (buttonPosition === 'bottom') {
                // Verschiedene Einstellungen für Desktop und Mobile
                const isMobile = window.innerWidth <= 768;

                // Erstelle einen Intersection Observer für den Footer
                this.observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                // Footer ist sichtbar - Button ausblenden
                                this.hideButton();
                            } else {
                                // Footer ist nicht sichtbar - Button einblenden
                                this.showButton();
                            }
                        });
                    },
                    {
                        // Bessere Threshold-Werte für Mobile
                        threshold: isMobile ? 0.1 : 0.2,
                        // Angepasste Margins um Überlappungen zu vermeiden
                        rootMargin: isMobile ? '0px 0px -30px 0px' : '0px 0px -80px 0px'
                    }
                );

                this.observer.observe(this.footer);

                // Bei Resize-Events Observer neu initialisieren
                let resizeTimeout;
                window.addEventListener('resize', () => {
                    clearTimeout(resizeTimeout);
                    resizeTimeout = setTimeout(() => {
                        if (this.observer) {
                            this.observer.disconnect();
                            this.init();
                        }
                    }, 250);
                });

                // Cleanup bei Seitenwechsel
                document.addEventListener('astro:before-preparation', () => {
                    if (this.observer) {
                        this.observer.disconnect();
                    }
                });
            }
        }

        hideButton() {
            if (!this.isHidden) {
                this.button.style.transform = 'translateX(100%)';
                this.button.style.opacity = '0';
                this.isHidden = true;
            }
        }

        showButton() {
            if (this.isHidden) {
                this.button.style.transform = 'translateX(0)';
                this.button.style.opacity = '1';
                this.isHidden = false;
            }
        }
    }

    // Initialisiere den Controller
    document.addEventListener('DOMContentLoaded', () => {
        new FixedButtonController();
    });

    // Für SPA Navigation
    document.addEventListener('astro:page-load', () => {
        new FixedButtonController();
    });
</script>

<style>
.contact-button {
    /* Kompakter Button ohne Innenabstand */
    text-decoration: none;
    display: inline-flex;
    align-items: center;

    /* Smooth transitions */
    transition: all 0.3s ease-in-out;

    /* Weniger aufdringlich positioniert */
    margin-right: 0;
    }

.contact-button:hover {
    transform: translateY(-2px) scale(1.05);
    }

/* Responsive Design - angepasste Größen für Mobile */
@media (max-width: 768px) {
    .contact-button {
    /* Normal-Größe beibehalten auf Mobile */
    }

    .contact-button div {
    padding: 1rem;
    }

    .contact-button svg {
    width: 28px;
    height: 28px;
    }
    }

/* Für sehr kleine Bildschirme nur leicht kleiner */
@media (max-width: 480px) {
    .contact-button {
    bottom: 15px !important;
    }

    .contact-button div {
    padding: 0.875rem;
    }

    .contact-button svg {
    width: 26px;
    height: 26px;
    }
    }

/* Verhindere Überlappung mit anderem Content */
.contact-button {
    pointer-events: auto;
    }

/* Animation für das Ein- und Ausblenden */
.contact-button {
    transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
    }
</style>