---
import CourseDropdown from "./CourseDropdown.astro";
import ScheduledTableAutumnQiMengDa from "./ScheduledTableAutumnQiMengDa.astro";
import ScheduledTableAutumnQinzi1 from "./ScheduledTableAutumnQinzi1.astro";
import ScheduledTableAutumnQinzi2 from "./ScheduledTableAutumnQinzi2.astro";
import ScheduledTableAutumnQiMengXiao from "./ScheduledTableAutumnQiMengXiao.astro";
import ScheduledTableSpringQinzi1 from "./ScheduledTableSpringQinzi1.astro";
import ScheduledTableSpringQinzi2 from "./ScheduledTableSpringQinzi2.astro";
import ScheduledTableSpringQiMengXiao from "./ScheduledTableSpringQiMengXiao.astro";
import ScheduledTableSpringSaturday from "./ScheduledTableSpringSaturday.astro";

// Dropdown-Konfigurationen
const autumnCourses = [
	{
		id: "qinzi-autumn1",
		label: "亲子大1班",
		component: ScheduledTableAutumnQinzi1
	},
    {
		id: "qinzi-autumn2",
		label: "亲子大2班",
		component: ScheduledTableAutumnQinzi2
	},
    {
		id: "qimengxiao-autumn",
		label: "启蒙小1班",
		component: ScheduledTableAutumnQiMengXiao
	},
	{
		id: "qimengda-autumn",
		label: "启蒙大1班",
		component: ScheduledTableAutumnQiMengDa
	}
];

const springCourses = [
    {
		id: "qinzi-spring-1",
		label: "亲子大1班",
		component: ScheduledTableSpringQinzi1
	},
	{
		id: "qinzi-spring-2",
		label: "亲子大3班",
		component: ScheduledTableSpringQinzi2
	}, 
    {
		id: "qimengxiao-spring",
		label: "启蒙小1班",
		component: ScheduledTableSpringQiMengXiao
	},
    {
		id: "qimengda-spring",
		label: "启蒙大1班",
		component: ScheduledTableSpringSaturday
	}
];


---

<div class="course-schedule-grid grid gap-8 w-full items-start">
        <CourseDropdown
        titlePart1="2026春季"
        titlePart2="学期课程表"
        titlePart1Color="#5eab7e"
        titlePart2Color="#2980b9"
        courses={springCourses}
        uniqueId="spring-qimeng"
    />

    <CourseDropdown
        titlePart1="2026 秋季"
        titlePart2="学期课程表"
        titlePart1Color="#DAA520"
        titlePart2Color="#2980b9"
        courses={autumnCourses}
        uniqueId="autumn-qimeng"
    />

</div>

<style>
    /* Explizites Grid-Layout für Stabilität bei View Transitions */
    .course-schedule-grid {
        grid-template-columns: 1fr;
    }
    @media (min-width: 1024px) {
        .course-schedule-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>