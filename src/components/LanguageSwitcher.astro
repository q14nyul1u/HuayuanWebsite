---
// LanguageSwitcher.astro
export interface Props {
    currentLang?: string;
    currentPath?: string;
}

const {currentLang = 'zh', currentPath = '/'} = Astro.props;

const languages = [
    { code: 'de', name: 'Deutsch', flag: '🇩🇪' },
    { code: 'zh', name: '中文', flag: '🇨🇳' }
];

// Zeige die andere Sprache als Button
const targetLanguage = languages.find(lang => lang.code !== currentLang) || languages[0];
---

<div class="language-switcher" data-current-lang={currentLang} data-current-path={currentPath}>
    <button
            type="button"
            class="language-switch-button flex items-center gap-2 px-4 py-2 rounded-md text-sm font-medium transition-all duration-200 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:ring-offset-2 min-w-[120px] border border-gray-200 hover:border-gray-300 hover:shadow-md"
            data-target-lang={targetLanguage.code}
            aria-label={`Wechseln zu ${targetLanguage.name}`}
            title={`Wechseln zu ${targetLanguage.name}`}
    >
        <span class="text-lg">{targetLanguage.flag}</span>
        <span class="block whitespace-nowrap">{targetLanguage.name}</span>
        <svg class="w-4 h-4 ml-auto opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
        </svg>
    </button>
</div>

<script>
    class LanguageSwitcher {
        constructor(element) {
            this.element = element;
            this.button = element.querySelector('.language-switch-button');
            this.currentLang = element.dataset.currentLang;
            this.currentPath = element.dataset.currentPath;

            this.init();
        }

        init() {
            // Handle language switch on button click
            this.button.addEventListener('click', (e) => {
                e.preventDefault();
                const targetLang = this.button.dataset.targetLang;
                this.changeLanguage(targetLang);
            });
        }

        changeLanguage(newLang) {
            // Store preference in localStorage
            localStorage.setItem('preferred-language', newLang);

            // Generate new URL
            let newPath = this.currentPath;

            // Remove existing language prefix
            newPath = newPath.replace(/^\/(de|zh)/, '');

            // Add new language prefix (except for default language)
            if (newLang !== 'zh') {
                newPath = `/${newLang}${newPath}`;
            }

            // Ensure we have a valid path
            if (!newPath || newPath === '') {
                newPath = '/';
            }

            // Navigate to new URL
            window.location.href = newPath;
        }
    }

    // Initialize all language switchers on the page
    document.addEventListener('DOMContentLoaded', () => {
        const switchers = document.querySelectorAll('.language-switcher');
        switchers.forEach(switcher => new LanguageSwitcher(switcher));
    });

    // Reinitialize when navigating (for SPAs)
    document.addEventListener('astro:page-load', () => {
        const switchers = document.querySelectorAll('.language-switcher');
        switchers.forEach(switcher => new LanguageSwitcher(switcher));
    });
</script>

<style>
.language-switcher {
    /* Ensure proper positioning context */
    position: relative;
    }

/* Enhanced button styling - Höhere Spezifität ohne !important */
.language-switcher .language-switch-button {
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    color: #374151;
    border-color: #d1d5db;
    transition: all 0.2s ease-in-out;
    }

.language-switcher .language-switch-button:hover {
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border-color: #9ca3af;
    color: #1f2937;
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

.language-switcher .language-switch-button:active {
    transform: translateY(0);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

/* Focus styles for accessibility */
.language-switcher .language-switch-button:focus {
    outline: 2px solid var(--brand-light-blue, #5dade2);
    outline-offset: 2px;
    }

/* Icon animation on hover */
.language-switcher .language-switch-button:hover svg {
    opacity: 1;
    transform: translateX(2px);
    transition: all 0.2s ease-in-out;
    }

/* Responsive adjustments */
@media (max-width: 640px) {
    .language-switcher .language-switch-button {
    min-width: 100px;
    padding: 8px 12px;
    font-size: 0.875rem;
    }

    .language-switcher .language-switch-button span.text-lg {
    font-size: 1rem;
    }
    }

/* Überschreibe Dark Mode mit höherer Spezifität */
@media (prefers-color-scheme: dark) {
    .language-switcher .language-switch-button {
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    border-color: #d1d5db;
    color: #374151;
    }

    .language-switcher .language-switch-button:hover {
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border-color: #9ca3af;
    color: #1f2937;
    }
    }
</style>