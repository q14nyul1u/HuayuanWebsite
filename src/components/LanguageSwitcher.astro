---
// LanguageSwitcher.astro
export interface Props {
    currentLang?: string;
    currentPath?: string;
}

const {currentLang = 'zh', currentPath = '/'} = Astro.props;

const languages = [
    {code: 'de', name: 'Deutsch', flag: '🇩🇪', shortCode: 'DE'},
    {code: 'zh', name: '中文', flag: '🇨🇳', shortCode: '中文'}
];
---

<div class="language-switcher" data-current-lang={currentLang} data-current-path={currentPath}>
    <div class="language-options flex gap-2">
        {languages.map(lang => (
                <button
                        type="button"
                        class={`language-option flex flex-col items-center p-3 rounded-lg transition-all duration-200 min-w-[60px] ${
                            currentLang === lang.code
                                ? 'language-option-active bg-blue-100 border-2 border-blue-500'
                                : 'language-option-inactive bg-white border border-gray-200 hover:bg-gray-50 hover:border-gray-300'
                        }`}
                        data-target-lang={lang.code}
                        aria-label={`Wechseln zu ${lang.name}`}
                        title={`Wechseln zu ${lang.name}`}
                >
                    <span class="flag text-2xl mb-1">{lang.flag}</span>
                    <span class="code text-xs font-medium text-gray-700">{lang.shortCode}</span>
                </button>
        ))}
    </div>
</div>

<script>
    class LanguageSwitcher {
        constructor(element) {
            this.element = element;
            this.buttons = element.querySelectorAll('.language-option');
            this.currentLang = element.dataset.currentLang;
            this.currentPath = element.dataset.currentPath;

            this.init();
        }

        init() {
            // Handle language switch on button click
            this.buttons.forEach(button => {
                button.addEventListener('click', (e) => {
                    e.preventDefault();
                    const targetLang = button.dataset.targetLang;

                    // Don't change if it's already the current language
                    if (targetLang !== this.currentLang) {
                        this.changeLanguage(targetLang);
                    }
                });
            });
        }

        changeLanguage(newLang) {
            // Store preference in localStorage
            localStorage.setItem('preferred-language', newLang);

            // Generate new URL
            let newPath = this.currentPath;

            // Remove existing language prefix
            newPath = newPath.replace(/^\/(de|zh)/, '');

            // Add new language prefix (except for default language)
            if (newLang !== 'zh') {
                newPath = `/${newLang}${newPath}`;
            }

            // Ensure we have a valid path
            if (!newPath || newPath === '') {
                newPath = '/';
            }

            // Navigate to new URL
            window.location.href = newPath;
        }
    }

    // Initialize all language switchers on the page
    document.addEventListener('DOMContentLoaded', () => {
        const switchers = document.querySelectorAll('.language-switcher');
        switchers.forEach(switcher => new LanguageSwitcher(switcher));
    });

    // Reinitialize when navigating (for SPAs)
    document.addEventListener('astro:page-load', () => {
        const switchers = document.querySelectorAll('.language-switcher');
        switchers.forEach(switcher => new LanguageSwitcher(switcher));
    });
</script>

<style>
.language-switcher {
    position: relative;
    }

.language-options {
    display: flex;
    gap: 8px;
    align-items: center;
    }

.language-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px;
    border-radius: 8px;
    min-width: 60px;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    background: white;
    border: 1px solid #d1d5db;
    }

.language-option:hover {
    background: #f9fafb;
    border-color: #9ca3af;
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

.language-option-active {
    background: #dbeafe !important;
    border: 2px solid #3b82f6 !important;
    color: #1e40af;
    }

.language-option-active:hover {
    background: #bfdbfe !important;
    border-color: #2563eb !important;
    }

.language-option .flag {
    font-size: 1.5rem;
    line-height: 1;
    margin-bottom: 4px;
    }

.language-option .code {
    font-size: 0.75rem;
    font-weight: 500;
    color: #374151;
    line-height: 1;
    }

.language-option-active .code {
    color: #1e40af;
    font-weight: 600;
    }

/* Focus styles for accessibility */
.language-option:focus {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
    }

/* Responsive adjustments */
@media (max-width: 640px) {
    .language-option {
    min-width: 50px;
    padding: 10px;
    }

    .language-option .flag {
    font-size: 1.25rem;
    }

    .language-option .code {
    font-size: 0.7rem;
    }
    }

/* Dark mode overrides */
@media (prefers-color-scheme: dark) {
    .language-option {
    background: white;
    border-color: #d1d5db;
    }

    .language-option:hover {
    background: #f9fafb;
    border-color: #9ca3af;
    }

    .language-option .code {
    color: #374151;
    }

    .language-option-active .code {
    color: #1e40af;
    }
    }
</style>